<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Başlık -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Link kartı -->
        <com.google.android.material.card.MaterialCardView
            style="@style/IndiriciCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/IndiriciInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/url_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="3"
                        android:minHeight="52dp"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaste"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="@string/paste"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/surface_alt" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenFolder"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/open_downloads"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/surface_alt" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mod ve kalite -->
        <com.google.android.material.card.MaterialCardView
            style="@style/IndiriciCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbVideo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/accent"
                        android:checked="true"
                        android:text="@string/mode_video"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/accent"
                        android:text="@string/mode_audio"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/quality_label"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spQuality"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/accent"
                    android:popupBackground="@color/surface_alt" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- İndir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/download"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:visibility="gone"
            app:cornerRadius="14dp"
            app:strokeColor="@color/danger" />

        <!-- İlerleme -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="invisible"
            app:indicatorColor="@color/accent"
            app:trackColor="@color/surface_alt"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preparing"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/success"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="Instagram · YouTube · TikTok · X · Facebook · Pinterest ve daha fazlası"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="yt-dlp'yi güncelle"
            android:textAllCaps="false"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/surface_alt" />
    </LinearLayout>
</ScrollView>
